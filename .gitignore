# Rust
target/

# Node.js
node_modules/
dist/

# TEE image artifacts
*.eif

# OS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment
.env
.env.*
!.env.example

# Keys (README は allowlist して取り扱いガイドだけ tracked にする)
keys/*
!keys/README.md
*.pem
keypair.json

# Legacy code (local reference only, history preserved in git).
# `Cargo.toml [workspace].exclude` でも除外しているが、こちらは「新規
# ファイルを legacy/ 配下に追加させない」運用ルール。既存ファイルを
# 修正する場合は track 済みなので直接編集可能。`programs/` と
# `sp1-guests/` は workspace 外だが意図的に tracked にしており、
# `.gitignore` の対象外にしている。
legacy/

# TEE runtime artifacts captured from a live enclave (regenerated on
# every boot — do not commit). The capture scripts that produce them
# live under deploy/aws/scripts/.
deploy/aws/build/

# Local stack runtime state (PIDs, logs)
.local-stack/
